# 复制本文件为 backend/.env 后按需修改（.env 已被 .gitignore 排除，不会提交）

# 数据库：PostgreSQL（语义检索依赖 pgvector 扩展）
# 端口示例用 5433，避免与同机其它 PG 实例抢占 5432
DATABASE_URL=postgresql+psycopg://partkeeper:your-password@127.0.0.1:5433/partkeeper

# 连接池：gunicorn 多 worker 时注意总连接数不超过 PG 的 max_connections
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

# ===== 语义检索（元器件参数向量搜索）=====
# 首次调用会下载 BAAI/bge-small-zh-v1.5（约 100MB），需要网络
EMBEDDING_ENABLED=1
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 启动时自动补齐缺失向量（大库会拖慢启动，默认关闭，用 /api/components/semantic-reindex 手动触发）
EMBEDDING_SYNC_ON_STARTUP=0

# 应用
APP_HOST=0.0.0.0
APP_PORT=5000

# 安全相关：务必改成一段随机字符串
SECRET_KEY=please-change-me-to-a-random-secret
JWT_EXPIRATION_HOURS=24

# 初始管理员（首次启动自动创建；登录后请尽快改密或另建账号）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
ADMIN_EMAIL=admin@example.com

# ===== MCP Server（对外通信，供 WorkBuddy 连接器访问）=====
# 监听地址与端点：http://<MCP_HOST>:<MCP_PORT><MCP_PATH>
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
# 连接器静态密钥（Bearer Token）。正式使用请生成随机串，例如：
#   python -c "import secrets; print('pk_mcp_' + secrets.token_urlsafe(32))"
# 注意：日常连接器建议改用 Web 端「访问令牌」页面发放的 pk_ 令牌（可命名/可撤销/免重启），
#       本项留空即可；仅作为全局应急密钥保留。
MCP_API_KEY=
# 通过 MCP 执行库存操作时记录的 operator_id（默认 1 = admin）
MCP_OPERATOR_ID=1
# MCP 对外访问地址，用于 Web「访问令牌」页展示的连接信息。
# 填**客户端实际能访问到的地址**（反代后的端口，不是 MCP_PORT 本机端口）。
# 反代、换域名或端口映射时必须显式填写，否则按「当前访问主机名 + MCP_PORT + MCP_PATH」推断。
# 改完必须重启对应服务，EnvironmentFile 只在进程启动时注入。
# MCP_PUBLIC_URL=http://example.com:8090/mcp

# ===== 凭证附件 =====
# 开支凭证图片落盘目录（非公开目录，不经静态文件服务暴露）。
# 留空默认 backend/instance/uploads/。库里只存路径+SHA-256+大小+MIME，二进制不入库。
# UPLOAD_DIR=

# ===== EDA 插件直连 =====
# KiCad / EasyEDA 插件调用 /api/integrations/* 时的跨域来源。
# 接口本身要求 Bearer 令牌，来源限制只是附加防线；默认放开，需要收紧时填具体域名。
# EasyEDA 扩展运行在浏览器宿主内，收紧后必须把 EDA 站点域名加进来。
# PLUGIN_CORS_ORIGINS=*
