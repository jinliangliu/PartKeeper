# 复制本文件为 backend/.env 后按需修改（.env 已被 .gitignore 排除，不会提交）

# 数据库：SQLite 单文件（相对路径会自动落在 backend/instance/app.db）
DATABASE_URL=sqlite:///app.db

# 应用
APP_HOST=0.0.0.0
APP_PORT=5000

# 安全相关：务必改成一段随机字符串
SECRET_KEY=please-change-me-to-a-random-secret
JWT_EXPIRATION_HOURS=24

# 初始管理员（首次启动自动创建；登录后请尽快改密或另建账号）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
ADMIN_EMAIL=admin@example.com

# ===== MCP Server（对外通信，供 WorkBuddy 连接器访问）=====
# 监听地址与端点：http://<MCP_HOST>:<MCP_PORT><MCP_PATH>
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
# 连接器静态密钥（Bearer Token）。正式使用请生成随机串，例如：
#   python -c "import secrets; print('pk_mcp_' + secrets.token_urlsafe(32))"
# 留空则仅接受用 SECRET_KEY 签发、role=admin 的 JWT
MCP_API_KEY=
# 通过 MCP 执行库存操作时记录的 operator_id（默认 1 = admin）
MCP_OPERATOR_ID=1

# ===== 凭证附件 =====
# 开支凭证图片落盘目录（非公开目录，不经静态文件服务暴露）。
# 留空默认 backend/instance/uploads/。库里只存路径+SHA-256+大小+MIME，二进制不入库。
# UPLOAD_DIR=
